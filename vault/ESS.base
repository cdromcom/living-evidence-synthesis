formulas:
  node_type: if(file.inFolder("questions"), "QUE", if(file.inFolder("claims"), "CLM", if(file.inFolder("evidence"), "EVD", if(file.inFolder("caveats"), "CVT", "?"))))
  short_title: link(file, file.name.replace("EVD - ", "").replace("CLM - ", "").replace("CVT - ", "").replace("QUE - ", ""))
  dim_5c: if(file.tags.contains("5c/credibility"), "credibility ", "") + if(file.tags.contains("5c/clarity"), "clarity ", "") + if(file.tags.contains("5c/creativity"), "creativity ", "") + if(file.tags.contains("5c/connectivity"), "connectivity ", "") + if(file.tags.contains("5c/care"), "care", "")
  tripod_compliance: if(file.tags.contains("tripod-llm/compliance/high"), "high", if(file.tags.contains("tripod-llm/compliance/moderate"), "moderate", if(file.tags.contains("tripod-llm/compliance/low"), "low", "—")))
  appraisal_external: if(file.tags.contains("appraisal/external-validity/high-risk"), "high-risk", if(file.tags.contains("appraisal/external-validity/some-concerns"), "some-concerns", if(file.tags.contains("appraisal/external-validity/low-risk"), "low-risk", "—")))
  appraisal_statistical: if(file.tags.contains("appraisal/statistical-rigor/high-risk"), "high-risk", if(file.tags.contains("appraisal/statistical-rigor/some-concerns"), "some-concerns", if(file.tags.contains("appraisal/statistical-rigor/low-risk"), "low-risk", "—")))
properties:
  formula.node_type:
    displayName: Type
  formula.short_title:
    displayName: Title
  formula.dim_5c:
    displayName: 5C dimension(s)
  formula.tripod_compliance:
    displayName: TRIPOD-LLM bucket
  formula.appraisal_external:
    displayName: External validity
  formula.appraisal_statistical:
    displayName: Statistical rigor
  note.appraisal_overall:
    displayName: Appraisal (L-M-H)
  note.tripod_llm_pct:
    displayName: TRIPOD-LLM %
  note.NodeFormality:
    displayName: Status
  note.severity:
    displayName: Severity (CVT only)
  note.type:
    displayName: CVT type (author-stated / inferred)
  note.tags:
    displayName: Tags (full)
  note.nodeID:
    displayName: nodeID
  note.created:
    displayName: Created
  note.updated:
    displayName: Updated
views:
  - type: table
    name: All EVDs (table)
    filters:
      and:
        - file.name.startsWith("EVD -")
    order:
      - formula.short_title
      - formula.dim_5c
      - formula.tripod_compliance
      - tripod_llm_pct
      - appraisal_overall
      - formula.appraisal_external
      - formula.appraisal_statistical
      - NodeFormality
    sort:
      - property: formula.appraisal_statistical
        direction: ASC
      - property: formula.short_title
        direction: ASC
    description: |
      Every EVD with rigor columns. `TRIPOD-LLM bucket` is computed from `tripod-llm/compliance/<bucket>` tags via an if-chain so you can filter on it directly via the column header. `Appraisal (L-M-H)` and `TRIPOD-LLM %` read from frontmatter fields synced by `scripts/sync_rigor_fields.py`. Single source of truth still lives in `tags:`.
    columnSize:
      formula.short_title: 380
  - type: table
    name: ❓ Questions (QUE)
    filters:
      and:
        - file.name.startsWith("QUE -")
    order:
      - formula.short_title
      - formula.dim_5c
      - NodeFormality
    sort:
      - property: formula.short_title
        direction: ASC
    description: 27 research questions in the corpus. Each ties to one or more papers and nests CLMs underneath.
  - type: table
    name: 💡 Claims (CLM)
    filters:
      and:
        - file.name.startsWith("CLM -")
    order:
      - formula.short_title
      - formula.dim_5c
      - NodeFormality
    sort:
      - property: formula.short_title
        direction: ASC
    description: 31 generalizations the corpus papers argue for. Each is grounded in one or more EVDs.
  - type: table
    name: 🔬 Evidence (EVD)
    filters:
      and:
        - file.name.startsWith("EVD -")
    order:
      - formula.short_title
      - formula.dim_5c
      - formula.tripod_compliance
      - appraisal_overall
      - NodeFormality
    sort:
      - property: formula.short_title
        direction: ASC
    description: 77 atomic empirical findings. One paper, one finding, one verbatim quote each.
  - type: table
    name: ⚠️ Caveats (CVT)
    filters:
      and:
        - file.name.startsWith("CVT -")
    order:
      - formula.short_title
      - severity
      - type
      - formula.dim_5c
      - NodeFormality
    sort:
      - property: severity
        direction: DESC
    description: 49 methodological limitations. Tagged by `cvt/domain`, `cvt/mechanism`, `cvt/type`, `cvt/severity`.
  - type: table
    name: 📋 TRIPOD-LLM · high (≥80%)
    filters:
      and:
        - file.name.startsWith("EVD -")
        - file.tags.contains("tripod-llm/compliance/high")
    order:
      - formula.short_title
      - tripod_llm_pct
      - appraisal_overall
      - formula.appraisal_external
    sort:
      - property: tripod_llm_pct
        direction: DESC
    description: |
      EVDs whose source paper reports ≥80% of the TRIPOD-LLM checklist. Currently empty in this corpus — no preprint clears the high bar — but the filter is wired so future high-compliance papers land here automatically.
  - type: table
    name: 📋 TRIPOD-LLM · moderate (60–80%)
    filters:
      and:
        - file.name.startsWith("EVD -")
        - file.tags.contains("tripod-llm/compliance/moderate")
    order:
      - formula.short_title
      - tripod_llm_pct
      - appraisal_overall
      - formula.appraisal_external
    sort:
      - property: tripod_llm_pct
        direction: DESC
    description: EVDs from papers in the middle of the corpus on TRIPOD-LLM reporting completeness.
  - type: table
    name: 📋 TRIPOD-LLM · low (<60%)
    filters:
      and:
        - file.name.startsWith("EVD -")
        - file.tags.contains("tripod-llm/compliance/low")
    order:
      - formula.short_title
      - tripod_llm_pct
      - appraisal_overall
      - formula.appraisal_external
    sort:
      - property: tripod_llm_pct
        direction: ASC
    description: EVDs from papers with the weakest TRIPOD-LLM reporting. Use with caution — methods are likely under-described.
  - type: table
    name: 🔴 External-validity · high-risk
    filters:
      and:
        - file.name.startsWith("EVD -")
        - file.tags.contains("appraisal/external-validity/high-risk")
    order:
      - formula.short_title
      - formula.dim_5c
      - appraisal_overall
      - tripod_llm_pct
    sort:
      - property: formula.short_title
        direction: ASC
    description: Papers whose findings won't generalize beyond the specific dataset / model / domain (single-discipline samples, opt-in user studies, single-conference corpora, etc.).
  - type: table
    name: 🔴 Statistical-rigor · high-risk
    filters:
      and:
        - file.name.startsWith("EVD -")
        - file.tags.contains("appraisal/statistical-rigor/high-risk")
    order:
      - formula.short_title
      - formula.dim_5c
      - appraisal_overall
      - tripod_llm_pct
    sort:
      - property: formula.short_title
        direction: ASC
    description: Papers without confidence intervals, paired tests, or multiple-comparison correction.
  - type: table
    name: 5C · Credibility (rigor)
    filters:
      and:
        - file.tags.contains("5c/credibility")
    order:
      - formula.node_type
      - formula.short_title
      - formula.dim_5c
    sort:
      - property: formula.node_type
        direction: ASC
    description: Error detection, risk-of-bias assessment, methodological evaluation.
  - type: table
    name: 5C · Clarity (reporting)
    filters:
      and:
        - file.tags.contains("5c/clarity")
    order:
      - formula.node_type
      - formula.short_title
      - formula.dim_5c
    sort:
      - property: formula.node_type
        direction: ASC
    description: CONSORT, PRISMA, AMSTAR, STROBE, ROBINS-I, QUADAS-2, PRECIS-2 reporting compliance.
  - type: table
    name: 5C · Creativity (novelty)
    filters:
      and:
        - file.tags.contains("5c/creativity")
    order:
      - formula.node_type
      - formula.short_title
      - formula.dim_5c
    sort:
      - property: formula.node_type
        direction: ASC
    description: Novelty assessment and peer-review feedback for innovation.
  - type: table
    name: 5C · Connectivity (citations)
    filters:
      and:
        - file.tags.contains("5c/connectivity")
    order:
      - formula.node_type
      - formula.short_title
      - formula.dim_5c
    sort:
      - property: formula.node_type
        direction: ASC
    description: Citation integrity, quotation errors.
  - type: table
    name: 5C · Care (ethics)
    filters:
      and:
        - file.tags.contains("5c/care")
    order:
      - formula.node_type
      - formula.short_title
      - formula.dim_5c
    sort:
      - property: formula.node_type
        direction: ASC
    description: IRB review, informed consent, ethical review of clinical proposals.
  - type: table
    name: ⚠️ High-severity caveats
    filters:
      and:
        - file.name.startsWith("CVT -")
        - file.tags.contains("cvt/severity/high")
    order:
      - formula.short_title
      - severity
      - type
      - formula.dim_5c
    sort:
      - property: formula.short_title
        direction: ASC
    description: The most paper-undermining limitations in the corpus.
  - type: table
    name: ⚠️ Inferred caveats (not author-stated)
    filters:
      and:
        - file.name.startsWith("CVT -")
        - file.tags.contains("cvt/type/inferred")
    order:
      - formula.short_title
      - severity
      - formula.dim_5c
    sort:
      - property: formula.short_title
        direction: ASC
    description: Limitations identified by the extractor that authors didn't flag themselves; treat with extra scrutiny.
  - type: table
    name: ⚠️ External-validity caveats
    filters:
      and:
        - file.name.startsWith("CVT -")
        - file.tags.contains("cvt/domain/external-validity")
    order:
      - formula.short_title
      - severity
      - type
    sort:
      - property: severity
        direction: DESC
    description: Generalizability constraints — the most common kind of caveat.
  - type: table
    name: ⚠️ Internal-validity caveats
    filters:
      and:
        - file.name.startsWith("CVT -")
        - file.tags.contains("cvt/domain/internal-validity")
    order:
      - formula.short_title
      - severity
      - type
    sort:
      - property: severity
        direction: DESC
    description: Bias in the comparison itself (contamination, leakage, judge circularity).
  - type: table
    name: ⚠️ Construct-validity caveats
    filters:
      and:
        - file.name.startsWith("CVT -")
        - file.tags.contains("cvt/domain/construct-validity")
    order:
      - formula.short_title
      - severity
      - type
    sort:
      - property: severity
        direction: DESC
    description: Metric ↔ deployment-construct mismatches.
  - type: table
    name: ⚠️ Reproducibility caveats
    filters:
      and:
        - file.name.startsWith("CVT -")
        - file.tags.contains("cvt/domain/reproducibility")
    order:
      - formula.short_title
      - severity
      - type
    sort:
      - property: severity
        direction: DESC
    description: Code / data / inference-parameter availability gaps.
  - type: table
    name: 📝 Drafts (still need verification)
    filters:
      and:
        - note.NodeFormality == "draft"
    order:
      - formula.node_type
      - formula.short_title
      - NodeFormality
    sort:
      - property: formula.node_type
        direction: ASC
    description: "Nodes still at `NodeFormality: draft`, awaiting verbatim-audit fixes."
  - type: cards
    name: 🃏 Cards · best-defended EVDs
    filters:
      and:
        - file.name.contains("EVD")
        - file.tags.contains("tripod-llm/compliance/moderate")
        - file.tags.contains("appraisal/internal-validity/low-risk")
    order:
      - formula.short_title
      - formula.dim_5c
      - appraisal_overall
      - tripod_llm_pct
    sort:
      - property: tripod_llm_pct
        direction: DESC
    description: |
      Card layout filtered to the "best-defended-comparison" EVDs: TRIPOD-LLM moderate compliance × appraisal internal-validity low-risk. Each card surfaces title + 5C dimensions + appraisal summary + TRIPOD-LLM percentage at a glance.
