# Supabase project (see supabase/schema.sql + README.md "Review backend").
# Get these from: Supabase dashboard -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Stable origin that sign-in emails link back to (no trailing slash). Leave
# unset for local dev and the app falls back to whatever origin the browser is
# on. Set it in production so the link half of the email points at the real
# domain rather than a per-deployment Vercel preview URL. Whatever you use must
# also be listed under Supabase -> Authentication -> URL Configuration ->
# Redirect URLs, or Supabase silently falls back to the project's Site URL.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# GitHub OAuth "Contribute" flow (lib/github.ts, app/api/github/*).
# Powers the "Sign in with GitHub" button on /contribute — lets a visitor
# fork this repo, commit a new node file on a branch, and open a PR.
# Create the OAuth App at: https://github.com/settings/developers
# Its "Authorization callback URL" must exactly match GITHUB_OAUTH_REDIRECT_URI
# below, for whichever origin you're deploying to (a stable production
# domain, not a per-deployment Vercel preview URL — those change on every
# push, so an OAuth callback registered against one will 404 on the next).
GITHUB_CLIENT_ID=your-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-oauth-app-client-secret
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3000/api/github/callback
# Repo the "Contribute" flow forks and opens PRs against.
GITHUB_REPO_OWNER=your-github-username-or-org
GITHUB_REPO_NAME=your-repo-name
GITHUB_REPO_BASE_BRANCH=main
